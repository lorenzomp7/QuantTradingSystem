# Copia questo file in `.env` per lo sviluppo locale:  cp .env.example .env
# Su Render queste variabili si impostano in Environment (o via render.yaml).

ENVIRONMENT=development
LOG_LEVEL=INFO
CONTROL_API_KEY=cambia-questa-chiave

# Dati: yahoo | mock
DATA_SOURCE=yahoo
SYMBOL=SPY
DATA_PERIOD=2y
DATA_INTERVAL=1d

# Strategia Moving Average Crossover
SHORT_WINDOW=20
LONG_WINDOW=50
INITIAL_CAPITAL=10000
FEE_BPS=5
TRADE_QUANTITY=10

# Bot
LOOP_INTERVAL_SECONDS=300
AUTO_START_BOT=false

# Broker: paper | alpaca | ccxt
BROKER=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET=
CCXT_SANDBOX=true
